# Dispatcher の環境変数の見本。コピーして .env にして使う(.env はコミットしない)。
# 開発では、server が起動時にリポジトリ直下の .env を読む(既にある環境変数は上書きしない)。
# 本番(Docker)は環境変数で渡し、.env をイメージに入れない。
# 値が空なら「未設定」として扱う。取り決めは docs/interfaces-1105.md。

# --- Claude(アプリ内の AI。Managed Agents) ---

# Anthropic の API キー。無ければ AI(チャットと前提情報の調査)は使えない。ほかの機能はボタンですべて動く。
# エージェントを ant apply で作ったのと同じワークスペースのキーにする
ANTHROPIC_API_KEY=

# ワークスペースに結びつかない API キーで必要になるときだけ設定する(ヘッダー anthropic-workspace-id)。
# ワークスペース単位のキーでは不要
ANTHROPIC_WORKSPACE_ID=

# 調整役のエージェントの ID(agent_…)。ant apply の後、claude-lock.json の
# .resources["./agents/coordinator.md"].id から写す
DISPATCHER_AGENT_ID=

# 調整役のエージェントの版(整数)。セッションはこの版に固定して作る。
# 名簿の調査役の版も一緒に固定されるかは、ant apply の後に確かめる(docs/interfaces-1105.md §2.4)。
# ant apply で版が上がっても、ここを書き換えるまで新しいセッションは前の版で動く。
# 調査役のファイルだけを直して ant apply しても、調整役の版が上がることがある
DISPATCHER_AGENT_VERSION=

# 実行環境の ID(env_…)。claude-lock.json の .resources["./environments/dispatcher.yaml"].id から写す
DISPATCHER_ENVIRONMENT_ID=

# セッションの取っ手に署名する秘密(32 バイト以上の乱数。例: python -c "import secrets; print(secrets.token_urlsafe(32))")。
# 本番では必ず設定する。無いと、DISPATCHER_DEV=1 のときは起動ごとに乱数で作り(再起動で会話が切れる)、
# そうでなければ(DISPATCHER_PUBLIC=1 でも)AI は使えない
DISPATCHER_SESSION_SECRET=

# 合言葉。設定すると、AI の中継は X-Dispatcher-Token ヘッダーの一致を求める(違えば 401)。
# API キーがあって合言葉が無いと、下の DISPATCHER_PUBLIC=1 か DISPATCHER_DEV=1 が無い限り AI は使えない
# (設定し忘れて誰でも呼べる状態になるのを防ぐ)
DISPATCHER_TOKEN=

# 本番で合言葉なしで公開するとき 1 にする(2026-11-03 の利用者の決定:AI も含めて合言葉なしで公開する)。
# 合言葉が無くても AI を使えるようにするだけで、取っ手の秘密などのほかの設定は省けない。
# 費用は、IP ごとの回数、1セッション・1日の利用額の上限(下の項目)と、Console のワークスペースの月の上限で守る。
# DISPATCHER_TOKEN も設定してあれば、合言葉を求める
DISPATCHER_PUBLIC=

# 開発用。1 のとき、合言葉と取っ手の秘密が無くても AI を使える(秘密は起動ごとの乱数)。
# 見本では切ってある。手元の開発でだけ、.env で行頭の # を外す。本番とコンテナでは付けない(DISPATCHER_PUBLIC を使う)
# DISPATCHER_DEV=1

# --- セッション ---

# 1セッションの料金の上限(セント。300 は 3 ドル)。セッションを作るときに budget として付ける
DISPATCHER_SESSION_BUDGET_CENTS=300

# 最後の操作から、セッションを消すまでの時間(時間)
DISPATCHER_SESSION_TTL_HOURS=24

# サーバーの SQLite の置き場所(セッションの表、1日の利用額、調査の結果)。本番はボリュームに置く
# DISPATCHER_DB=server/dispatcher.sqlite3

# --- 回数制限と利用額の上限(IP ごとの数え上げはメモリの中、全体のセッションの数は SQLite から。1日は日本時間の日付で区切る) ---

# IP アドレスごとの、セッションの作成の回数(1 時間・1 日)
DISPATCHER_SESSIONS_PER_IP_HOUR=3
DISPATCHER_SESSIONS_PER_IP_DAY=10
# IP アドレスごとの、1 時間あたりの発言の回数
DISPATCHER_MESSAGES_PER_IP_HOUR=40
# サーバー全体の、1 日あたりのセッションの作成の回数
DISPATCHER_SESSIONS_PER_DAY=20
# サーバー全体の、1 日あたりの利用額の上限(セント。定価で数えた額)。新しいセッションは、開いているセッションの
# 残りの予算を予約として足して数える(600 で 3 ドルのセッションは同時に2つまで)。台帳が達したら発言も止める。
# 最後の操作から 30 分ストリームがつながっていないセッション(閉じ損ねた画面)は、使った額(台帳)だけを数える
DISPATCHER_DAILY_COST_CENTS=600

# nginx の後ろで動かすとき 1 にする。X-Real-IP(nginx が $remote_addr で上書きする)を接続元とする。
# 1 でないときは接続元のアドレスを使い、X-Real-IP は読まない。X-Forwarded-For はどちらでも読まない
DISPATCHER_TRUST_PROXY=

# --- 前提情報の調査(11/6) ---

# 1回の調査で調べる対象(事業者・施設)の数の上限
DISPATCHER_RESEARCH_MAX_TARGETS=30
# 調査の結果を使い回す期間(日)。デモ用の保存済みの結果は期間で消さない
DISPATCHER_RESEARCH_CACHE_DAYS=7
# 調査の対象(施設・事業者)は、下の DISPATCHER_REF_DIR の参照データから引く(ブラウザが送った名前は使わない)。
# デモ用の保存済みの結果は、server で uv run dispatcher-research-seed <file> で取り込む(origin: demo。期限で消えず、
# 調査で上書きされない)。uv run dispatcher-research-seed --export <file> で、今ある結果を同じ形で書き出せる

# --- 配信するファイルの場所(既定はリポジトリの data/。本番はボリュームで渡す) ---

# DISPATCHER_SAMPLE_GTFS=/data/gtfs/dohoku_bus_減便前.zip
# DISPATCHER_REF_DIR=/data/ref

# ---- Docker(compose.yaml)だけで使う ----
# 公開するポート(127.0.0.1 のこのポートで画面と /api を出す。外側の nginx から中継する。既定 8080)
DISPATCHER_PORT=
# サンプル GTFS(道北バスの ZIP)のあるフォルダ(既定 ./data/raw/gtfs)
DISPATCHER_SAMPLE_DIR=
# 参照データ(data/out/ref)のフォルダ(既定 ./data/out/ref)
DISPATCHER_REF_HOST_DIR=
